# Local development database only. Never commit real credentials.
DATABASE_URL=postgresql://imajilearn:local_password@localhost:5432/imajilearn
# Optional direct Neon connection for migrations; runtime uses DATABASE_URL.
DATABASE_URL_UNPOOLED=
APP_ORIGIN=http://localhost:3000
# Internal PWA server, not a browser API URL. Development defaults to port 3002.
# Production: set before building web, e.g. http://pwa:3002; leave empty to disable.
PWA_INTERNAL_ORIGIN=
# Google web OAuth client; optional until Google sign-in is configured.
# Keep the client secret on the server. Callback: APP_ORIGIN/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Original learning-song generation (server only). Text uses an existing compatible Gemini/OpenAI endpoint.
AI_SONG_API_KEY=
AI_SONG_BASE_URL=
AI_SONG_MODEL=
KIE_API_KEY=
AI_MUSIC_BASE_URL=https://api.kie.ai/api/v1
AI_MUSIC_MODEL=V6
AI_MUSIC_TIMEOUT_MS=20000
AI_MUSIC_DURATION_SECONDS=120
SESSION_ABSOLUTE_SECONDS=604800
SESSION_IDLE_SECONDS=86400
REGISTER_IP_LIMIT=5
LOGIN_FAILURE_LIMIT=5
LOGIN_IP_LIMIT=30
# Set only if the reverse proxy strips/replaces this header.
TRUSTED_CLIENT_IP_HEADER=
# Optional isolated test database. Tests create and drop a random schema.
# TEST_DATABASE_URL=postgresql://imajilearn:local_password@localhost:5432/imajilearn_test

