generator client {
  provider = "prisma-client-js"
  output   = "../apps/web/server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Teacher {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(60)
  email        String   @unique @db.VarChar(254)
  passwordHash String
  school       String   @default("") @db.VarChar(100)
  grade        String   @default("") @db.VarChar(1)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  sessions     Session[]
  worksheetLibrary WorksheetLibrary?
  materials    Material[]
  idempotency  Idempotency[]
  mediaPreferences MediaPreference[]
}

model WorksheetLibrary {
  ownerId   String @id @db.Uuid
  lockVersion BigInt @default(0)
  teacher   Teacher @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  documents WorksheetDocument[]
}

model WorksheetDocument {
  id               String @id @db.Uuid
  ownerId          String @db.Uuid
  library          WorksheetLibrary @relation(fields: [ownerId], references: [ownerId], onDelete: Restrict)
  sourceMaterialId String? @db.Uuid
  sourceId         String @db.Uuid
  sourceTitle      String @db.VarChar(120)
  sourceRevision   String
  schemaVersion    Int @default(1)
  resourceVersion  Int @default(1)
  templateId       String @db.VarChar(8)
  templateVersion  Int @default(1)
  assetVersion     Int @default(1)
  grade            String @db.VarChar(1)
  language         String @db.VarChar(2)
  theme            String @db.VarChar(5)
  content          Json @db.JsonB
  displayOrder     Json @db.JsonB
  cacheKey         String @db.VarChar(64)
  createdAt        DateTime @db.Timestamptz(3)
  updatedAt        DateTime @db.Timestamptz(3)

  @@unique([ownerId, cacheKey])
  @@index([ownerId, updatedAt(sort: Desc), id(sort: Desc)])
  @@index([ownerId, sourceMaterialId])
}

model Session {
  tokenHash String   @id @db.Char(64)
  userId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  lastSeen  DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  teacher   Teacher  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RateLimit {
  key         String   @id @db.Char(64)
  count       Int
  windowStart DateTime @db.Timestamptz(3)

  @@index([windowStart])
}

model Material {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  title           String   @db.VarChar(120)
  text            String
  revision        String   @db.Char(64)
  archived        Boolean  @default(false)
  resourceVersion Int      @default(1)
  lockVersion     BigInt   @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @db.Timestamptz(3)
  teacher         Teacher  @relation(fields: [userId], references: [id], onDelete: Restrict)
  mediaPreference MediaPreference?

  @@unique([id, userId])
  @@index([userId, updatedAt, id])
}

model Idempotency {
  userId      String   @db.Uuid
  route       String   @db.VarChar(100)
  key         String   @db.VarChar(100)
  requestHash String   @db.Char(64)
  response    Json?    @db.JsonB
  expiresAt   DateTime @db.Timestamptz(3)
  lockVersion BigInt   @default(0)
  teacher     Teacher  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, route, key])
  @@index([expiresAt])
}

model MediaPreference {
  materialId      String   @id @db.Uuid
  userId          String   @db.Uuid
  selectedMedia   String[]
  songTemplateId  String   @default("balonku") @db.VarChar(32)
  resourceVersion Int      @default(1)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  material        Material @relation(fields: [materialId, userId], references: [id, userId], onDelete: Cascade)
  teacher         Teacher  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([materialId, userId])
  @@index([userId])
}
