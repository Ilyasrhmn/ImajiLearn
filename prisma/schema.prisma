generator client {
  provider = "prisma-client-js"
  output   = "../apps/web/server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Teacher {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(60)
  email        String   @unique @db.VarChar(254)
  passwordHash String
  school       String   @default("") @db.VarChar(100)
  grade        String   @default("") @db.VarChar(1)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
}
