# DeepSeek text profiles through KIE; Gemini is the shared fallback. Keys stay on the server.
# SONG generates lyrics; MUSIC generates vocals and accompaniment.
# Blank temperature/reasoning leaves the provider default.

AI_READING_BASE_URL=https://api.kie.ai/openai/v1/
AI_READING_API_KEY=
AI_READING_MODEL=deepseek-v4-1-flash
AI_READING_PROTOCOL=openai-responses
AI_READING_MAX_OUTPUT_TOKENS=4096
AI_READING_TOKEN_LIMIT_FIELD=max_completion_tokens
AI_READING_TEMPERATURE=
AI_READING_REASONING_EFFORT=none
AI_READING_RESPONSE_FORMAT=json_object
AI_READING_TIMEOUT_MS=120000

AI_MINDMAP_BASE_URL=https://api.kie.ai/openai/v1/
AI_MINDMAP_API_KEY=
AI_MINDMAP_MODEL=deepseek-v4-1-flash
AI_MINDMAP_PROTOCOL=openai-responses
AI_MINDMAP_MAX_OUTPUT_TOKENS=3072
AI_MINDMAP_TOKEN_LIMIT_FIELD=max_completion_tokens
AI_MINDMAP_TEMPERATURE=
AI_MINDMAP_REASONING_EFFORT=none
AI_MINDMAP_RESPONSE_FORMAT=json_object
AI_MINDMAP_TIMEOUT_MS=120000

AI_SLIDES_BASE_URL=https://api.kie.ai/openai/v1/
AI_SLIDES_API_KEY=
AI_SLIDES_MODEL=deepseek-v4-1-flash
AI_SLIDES_PROTOCOL=openai-responses
AI_SLIDES_MAX_OUTPUT_TOKENS=4096
AI_SLIDES_TOKEN_LIMIT_FIELD=max_completion_tokens
AI_SLIDES_TEMPERATURE=
AI_SLIDES_REASONING_EFFORT=none
AI_SLIDES_RESPONSE_FORMAT=json_object
AI_SLIDES_TIMEOUT_MS=120000

# SONG is text/lyrics. MUSIC below is the separate audio provider profile.
AI_SONG_BASE_URL=https://api.kie.ai/openai/v1/
AI_SONG_API_KEY=
AI_SONG_MODEL=deepseek-v4-1-flash
AI_SONG_PROTOCOL=openai-responses
AI_SONG_MAX_OUTPUT_TOKENS=2048
AI_SONG_TOKEN_LIMIT_FIELD=max_completion_tokens
AI_SONG_TEMPERATURE=
AI_SONG_REASONING_EFFORT=none
AI_SONG_RESPONSE_FORMAT=json_object
AI_SONG_TIMEOUT_MS=120000

AI_EXAM_BASE_URL=https://api.kie.ai/openai/v1/
AI_EXAM_API_KEY=
AI_EXAM_MODEL=deepseek-v4-1-flash
AI_EXAM_PROTOCOL=openai-responses
AI_EXAM_MAX_OUTPUT_TOKENS=4096
AI_EXAM_TOKEN_LIMIT_FIELD=max_completion_tokens
AI_EXAM_TEMPERATURE=
AI_EXAM_REASONING_EFFORT=none
AI_EXAM_RESPONSE_FORMAT=json_object
AI_EXAM_TIMEOUT_MS=120000

# Suno V6 through Kie.ai; KIE_API_KEY is shared with Z-Image.
KIE_API_KEY=
AI_MUSIC_BASE_URL=https://api.kie.ai/api/v1
AI_MUSIC_MODEL=V6
AI_MUSIC_TIMEOUT_MS=20000
AI_MUSIC_DURATION_SECONDS=120

# Z-Image is fixed in the adapter: at most 13 new images per output.
# Cloudflare FLUX handles simple and overflow visuals in parallel.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Used only after a recoverable primary text-provider failure.
AI_TEXT_FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_TEXT_FALLBACK_API_KEY=
AI_TEXT_FALLBACK_MODEL=gemini-3.1-flash-lite
# Optional separate Gemini credentials for illustration review; defaults to AI_TEXT_FALLBACK_*.
AI_IMAGE_REVIEW_API_KEY=
AI_IMAGE_REVIEW_MODEL=
AI_TEXT_FALLBACK_PROTOCOL=openai-chat
AI_TEXT_FALLBACK_RESPONSE_FORMAT=json_object
AI_TEXT_FALLBACK_TIMEOUT_MS=120000
