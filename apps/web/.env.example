# Copy to apps/web/.env.local. Keep credentials server-side.
# BASE_URL is the API root, without /chat/completions or query parameters.
# OpenAI-compatible examples: https://api.openai.com/v1/
# Gemini compatibility: https://generativelanguage.googleapis.com/v1beta/openai/
# Choose a model supported by that endpoint. Blank temperature/reasoning omits those parameters.
# TOKEN_LIMIT_FIELD may be max_completion_tokens or max_tokens; support depends on the model.
# RESPONSE_FORMAT may be json_object or json_schema; the latter requires a schema from the caller.

AI_READING_BASE_URL=
AI_READING_API_KEY=
AI_READING_MODEL=
AI_READING_PROTOCOL=openai-chat
AI_READING_MAX_OUTPUT_TOKENS=4096
AI_READING_TOKEN_LIMIT_FIELD=max_completion_tokens
AI_READING_TEMPERATURE=
AI_READING_REASONING_EFFORT=
AI_READING_RESPONSE_FORMAT=json_object
AI_READING_TIMEOUT_MS=45000

AI_MINDMAP_BASE_URL=
AI_MINDMAP_API_KEY=
AI_MINDMAP_MODEL=
AI_MINDMAP_PROTOCOL=openai-chat
AI_MINDMAP_MAX_OUTPUT_TOKENS=3072
AI_MINDMAP_TOKEN_LIMIT_FIELD=max_completion_tokens
AI_MINDMAP_TEMPERATURE=
AI_MINDMAP_REASONING_EFFORT=
AI_MINDMAP_RESPONSE_FORMAT=json_object
AI_MINDMAP_TIMEOUT_MS=45000

AI_SLIDES_BASE_URL=
AI_SLIDES_API_KEY=
AI_SLIDES_MODEL=
AI_SLIDES_PROTOCOL=openai-chat
AI_SLIDES_MAX_OUTPUT_TOKENS=4096
AI_SLIDES_TOKEN_LIMIT_FIELD=max_completion_tokens
AI_SLIDES_TEMPERATURE=
AI_SLIDES_REASONING_EFFORT=
AI_SLIDES_RESPONSE_FORMAT=json_object
AI_SLIDES_TIMEOUT_MS=45000

# SONG is text/lyrics. MUSIC below is the separate audio provider profile.
AI_SONG_BASE_URL=
AI_SONG_API_KEY=
AI_SONG_MODEL=
AI_SONG_PROTOCOL=openai-chat
AI_SONG_MAX_OUTPUT_TOKENS=2048
AI_SONG_TOKEN_LIMIT_FIELD=max_completion_tokens
AI_SONG_TEMPERATURE=
AI_SONG_REASONING_EFFORT=
AI_SONG_RESPONSE_FORMAT=json_object
AI_SONG_TIMEOUT_MS=45000

AI_EXAM_BASE_URL=
AI_EXAM_API_KEY=
AI_EXAM_MODEL=
AI_EXAM_PROTOCOL=openai-chat
AI_EXAM_MAX_OUTPUT_TOKENS=4096
AI_EXAM_TOKEN_LIMIT_FIELD=max_completion_tokens
AI_EXAM_TEMPERATURE=
AI_EXAM_REASONING_EFFORT=
AI_EXAM_RESPONSE_FORMAT=json_object
AI_EXAM_TIMEOUT_MS=45000

# Suno music through Kie.ai. Keep credentials on the server.
KIE_API_KEY=
AI_MUSIC_BASE_URL=https://api.kie.ai/api/v1
AI_MUSIC_MODEL=V6
AI_MUSIC_TIMEOUT_MS=20000
AI_MUSIC_DURATION_SECONDS=120

# Z-Image illustrations and Suno music share the server-only KIE_API_KEY.
